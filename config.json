{
  "server": {
    "host": "rfmc.aternos.me",
    "port": 61751,
    "version": "auto",
    "auth": "offline"
  },
  "bot": {
    "baseUsername": "AFKBot",
    "bot1Username": "AFKBot_1",
    "bot2Username": "AFKBot_2"
  },
  "dualBot": {
    "enabled": true,
    "shiftInterval": 300000,
    "backupDelay": 3000
